# Authentik environment — KEYS ONLY (deploy.sh fills values + generates secrets).
# Keep this file chmod 600 after rendering. NEVER commit the rendered .env.

# --- Image / version (pin for reproducibility) ---
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
AUTHENTIK_TAG=2026.5.2

# --- Local bind ports (fronted by Cloudflare Tunnel) ---
COMPOSE_PORT_HTTP=__AUTH_PORT_HTTP__
COMPOSE_PORT_HTTPS=__AUTH_PORT_HTTPS__

# --- Postgres (PG_PASS GENERATED by deploy.sh: openssl rand) ---
PG_DB=authentik
PG_USER=authentik
PG_PASS=__GENERATE__

# --- App secret (GENERATED: openssl rand -hex 64) ---
AUTHENTIK_SECRET_KEY=__GENERATE__

AUTHENTIK_ERROR_REPORTING__ENABLED=false

# --- Bootstrap admin (akadmin) — APPLIED ON FIRST DB INIT ONLY ---
# GOTCHA: these only take effect on the very first `up` against an empty DB.
# Changing them later does nothing; reset via the akadmin UI / `ak` CLI instead.
AUTHENTIK_BOOTSTRAP_PASSWORD=__GENERATE__
AUTHENTIK_BOOTSTRAP_EMAIL=__ADMIN_EMAIL__
# Bootstrap API token — lets deploy automation drive the API on first boot.
# Same first-init-only caveat. Saved to ./.apitoken (chmod 600) for later use.
AUTHENTIK_BOOTSTRAP_TOKEN=__GENERATE__
