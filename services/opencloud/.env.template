## OpenCloud — KEYS ONLY. deploy.sh fills domains + generates the admin password.
## Behind external reverse proxy (Cloudflare Tunnel), plain HTTP, 127.0.0.1 only.

# --- Compose overlays: base + collabora + external-proxy binds ---
COMPOSE_FILE=docker-compose.yml:weboffice/collabora.yml:external-proxy/opencloud.yml:external-proxy/collabora.yml
COMPOSE_PATH_SEPARATOR=:

# --- Public URL / domain (MUST match the Cloudflare ingress hostname) ---
# GOTCHA: OC_DOMAIN is baked into the OIDC issuer + built-in IdP on first init.
# Decide the final hostname BEFORE first `up`; changing it later breaks login.
OC_DOMAIN=__FILES_DOMAIN__

# --- Image: rolling release, tag pinned for reproducibility ---
OC_DOCKER_IMAGE=opencloudeu/opencloud-rolling
OC_DOCKER_TAG=6.2.0

# --- Behind reverse proxy: skip internal cert validation ---
INSECURE=true

# --- Persistent storage (blank => named docker volumes) ---
OC_CONFIG_DIR=__OC_CONFIG_DIR__
OC_DATA_DIR=__OC_DATA_DIR__

# --- Built-in IdP admin (user "admin"). Password GENERATED by deploy.sh.
#     FIRST-INIT-ONLY — see GOTCHA above. ---
INITIAL_ADMIN_PASSWORD=__GENERATE__

DEMO_USERS=false
LOG_DRIVER=local
LOG_LEVEL=info

# --- Collabora CODE + WOPI collaboration ---
COLLABORA_DOMAIN=__COLLABORA_DOMAIN__
WOPISERVER_DOMAIN=__WOPI_DOMAIN__

# Collabora serves plain HTTP internally; TLS terminates at Cloudflare.
COLLABORA_SSL_ENABLE=false
COLLABORA_SSL_VERIFICATION=false
COLLABORA_HOME_MODE=false

# Collabora admin console (/browser/dist/admin/admin.html). Password GENERATED.
COLLABORA_ADMIN_USER=admin
COLLABORA_ADMIN_PASSWORD=__GENERATE__

# --- SMTP (optional; deploy.sh fills from config.env if set) ---
SMTP_HOST=__SMTP_HOST__
SMTP_PORT=__SMTP_PORT__
SMTP_SENDER=__SMTP_FROM__
SMTP_USERNAME=__SMTP_USERNAME__
SMTP_PASSWORD=__SMTP_PASSWORD__
SMTP_TRANSPORT_ENCRYPTION=starttls
SMTP_AUTHENTICATION=login
