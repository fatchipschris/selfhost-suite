# Vaultwarden — KEYS ONLY. ADMIN_TOKEN is GENERATED by deploy.sh.
DOMAIN=https://__VAULT_DOMAIN__
# Admin panel token (/admin). GENERATED: openssl rand -base64 48.
ADMIN_TOKEN=__GENERATE__
# Open signups so you can create your first account, then set to false.
SIGNUPS_ALLOWED=true
WEBSOCKET_ENABLED=true

# --- SMTP (optional; deploy.sh fills from config.env if set) ---
SMTP_HOST=__SMTP_HOST__
SMTP_PORT=__SMTP_PORT__
SMTP_SECURITY=__SMTP_SECURITY__
SMTP_FROM=__SMTP_FROM__
SMTP_USERNAME=__SMTP_USERNAME__
SMTP_PASSWORD=__SMTP_PASSWORD__
