# Outline — KEYS ONLY. deploy.sh generates SECRET_KEY, UTILS_SECRET, the DB
# password, and assembles DATABASE_URL/REDIS_URL.
#
# OIDC: Outline has NO local password login — it REQUIRES an external IdP.
# This template wires it to Authentik. You must create the OAuth2/OIDC provider
# + application in Authentik first and paste the client id/secret below
# (deploy.sh leaves OIDC_CLIENT_ID / OIDC_CLIENT_SECRET as TODO and prints
# instructions). See README "First-login wiring".

# ---- Outline core ----
NODE_ENV=production
URL=https://__OUTLINE_DOMAIN__
PORT=3000
SECRET_KEY=__GENERATE__          # openssl rand -hex 32
UTILS_SECRET=__GENERATE__        # openssl rand -hex 32
FORCE_HTTPS=false                # TLS terminated upstream at Cloudflare

# ---- Database / Redis (internal compose network) ----
DATABASE_URL=postgres://outline:__DB_PASSWORD__@postgres:5432/outline
PGSSLMODE=disable
REDIS_URL=redis://redis:6379

# ---- File storage (local disk) ----
FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data
FILE_STORAGE_UPLOAD_MAX_SIZE=262144000

# ---- OIDC (Authentik) — fill client id/secret from Authentik provider ----
OIDC_CLIENT_ID=TODO_FROM_AUTHENTIK
OIDC_CLIENT_SECRET=TODO_FROM_AUTHENTIK
OIDC_AUTH_URI=https://__AUTH_DOMAIN__/application/o/authorize/
OIDC_TOKEN_URI=https://__AUTH_DOMAIN__/application/o/token/
OIDC_USERINFO_URI=https://__AUTH_DOMAIN__/application/o/userinfo/
OIDC_USERNAME_CLAIM=preferred_username
OIDC_DISPLAY_NAME=Authentik
OIDC_SCOPES=openid profile email

# ---- SMTP (optional; deploy.sh fills from config.env if set) ----
SMTP_HOST=__SMTP_HOST__
SMTP_PORT=__SMTP_PORT__
SMTP_USERNAME=__SMTP_USERNAME__
SMTP_PASSWORD=__SMTP_PASSWORD__
SMTP_FROM_EMAIL=__SMTP_FROM__
SMTP_REPLY_EMAIL=__SMTP_FROM__
SMTP_SECURE=false

# ---- Postgres container ----
POSTGRES_USER=outline
POSTGRES_PASSWORD=__DB_PASSWORD__
POSTGRES_DB=outline
