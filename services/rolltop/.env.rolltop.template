# Rolltop webmail — KEYS ONLY. ROLLTOP_MASTER_KEY is GENERATED by deploy.sh.
# Rolltop is a per-user IMAP/SMTP webmail client; users add their own mail
# accounts at login. The master key encrypts stored account credentials in
# rolltop.db — losing it means re-adding all accounts.
ROLLTOP_MASTER_KEY=__GENERATE__
# Set true only when served over HTTPS (it is, via Cloudflare Tunnel).
ROLLTOP_COOKIE_SECURE=true
