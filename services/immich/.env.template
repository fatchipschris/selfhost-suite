# Immich environment — KEYS ONLY. deploy.sh fills paths + generates DB_PASSWORD.
# Docs: https://docs.immich.app/install/environment-variables

# Pin to the rolling release tag.
IMMICH_VERSION=release

# Where photo/video ORIGINALS are stored (default ./data/upload, or a big disk).
UPLOAD_LOCATION=__UPLOAD_LOCATION__

# Where the Immich Postgres data dir lives (keep off the same disk as photos if
# you can; SSD strongly recommended for the DB).
DB_DATA_LOCATION=__DB_DATA_LOCATION__

TZ=__TZ__

# Strong random DB password — GENERATED by deploy.sh (openssl rand -hex 24).
DB_PASSWORD=__GENERATE__

# These do not need changing.
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
