# =============================================================================
#  Self-Hosted Productivity Suite — top-level configuration
#  Davenport Software · "Deploy your own private productivity suite"
# -----------------------------------------------------------------------------
#  Copy this file to `config.env` and edit. `deploy.sh` reads it.
#  NOTHING secret lives here — secrets are GENERATED per-service by deploy.sh.
# =============================================================================

# --- Base domain(s) --------------------------------------------------------
# Your apex / primary domain. Every service gets a subdomain under it by
# default (e.g. photos.${BASE_DOMAIN}, auth.${BASE_DOMAIN}, ...).
BASE_DOMAIN="example.com"

# Admin email (used as the bootstrap admin login + SMTP "from" defaults +
# Let's-Encrypt/Cloudflare contact). REQUIRED.
ADMIN_EMAIL="admin@example.com"

# Timezone for the stacks (IANA name, e.g. America/New_York, Europe/London).
# If left blank/unset, deploy.sh defaults to America/New_York.
TZ="America/New_York"

# --- Per-service public hostnames ------------------------------------------
# Override any of these if you don't want the default <prefix>.<BASE_DOMAIN>.
# These MUST match the Cloudflare Tunnel ingress hostnames (deploy.sh emits a
# ready-to-paste cloudflared config.yml using exactly these values).
AUTH_DOMAIN="auth.${BASE_DOMAIN}"            # Authentik (SSO / IdP)
PHOTOS_DOMAIN="photos.${BASE_DOMAIN}"        # Immich
FILES_DOMAIN="files.${BASE_DOMAIN}"          # OpenCloud (OC_DOMAIN)
COLLABORA_DOMAIN="collabora.${BASE_DOMAIN}"  # Collabora CODE editor UI
WOPI_DOMAIN="wopi.${BASE_DOMAIN}"            # OpenCloud collaboration/WOPI server
MAIL_DOMAIN="mail.${BASE_DOMAIN}"            # Rolltop webmail
VAULT_DOMAIN="vault.${BASE_DOMAIN}"          # Vaultwarden
OUTLINE_DOMAIN="outline.${BASE_DOMAIN}"      # Outline (knowledge base)
NOTES_DOMAIN="notes.${BASE_DOMAIN}"          # SilverBullet
HOME_DOMAIN="home.${BASE_DOMAIN}"            # Homepage (launcher dashboard)

# --- Which services to deploy ----------------------------------------------
# Set to "true" to enable, "false" to skip. Authentik is strongly recommended
# (Outline REQUIRES it for OIDC login). OpenCloud's Collabora/WOPI editing is
# enabled together with OpenCloud.
ENABLE_AUTHENTIK="true"
ENABLE_IMMICH="true"
ENABLE_OPENCLOUD="true"     # includes Collabora CODE + WOPI collaboration
ENABLE_ROLLTOP="true"
ENABLE_VAULTWARDEN="true"
ENABLE_OUTLINE="true"       # requires ENABLE_AUTHENTIK=true for login
ENABLE_SILVERBULLET="true"
ENABLE_HOMEPAGE="true"

# --- Storage locations ------------------------------------------------------
# Big data (photo originals, file storage, DBs) can live on a dedicated disk.
# These default to ./data under each service dir if left blank.
IMMICH_UPLOAD_LOCATION=""        # e.g. /mnt/photos
IMMICH_DB_DATA_LOCATION=""       # e.g. /mnt/photos/pgdata
OPENCLOUD_CONFIG_DIR=""          # e.g. /mnt/files/oc-config
OPENCLOUD_DATA_DIR=""            # e.g. /mnt/files/oc-data

# --- SMTP (optional; used by Outline, Vaultwarden, OpenCloud notifications) -
# Leave blank to skip email wiring. App-password style creds recommended.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM="${ADMIN_EMAIL}"
SMTP_SECURITY="starttls"         # starttls | force_tls | off

# --- Cloudflare Tunnel ------------------------------------------------------
# Name for the tunnel deploy.sh will create (if cloudflared is installed and
# you opt into the automated tunnel step). The tunnel UUID + credentials file
# are produced by `cloudflared tunnel create`.
CF_TUNNEL_NAME="selfhost-suite"
